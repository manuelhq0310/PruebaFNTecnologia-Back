@page "/register"
@using FrontApplication.Core.Enums
@using FrontApplication.Models
@using FrontApplication.Services
@inject UserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small">

    <MudPaper Class="pa-6">

        <MudText Typo="Typo.h5">
            Register
        </MudText>

        <MudForm @ref="_form">

            <MudTextField Label="Name"
                          @bind-Value="_model.Name"
                          Required="true" />

            <MudTextField Label="Email"
                          @bind-Value="_model.Email"
                          Required="true" />

            <MudTextField Label="Password"
                          InputType="InputType.Password"
                          @bind-Value="_model.Password"
                          Required="true" />

            <MudSelect T="UserRole"
                       Label="Role"
                       @bind-Value="_model.Role"
                       Required="true">
                @foreach (var role in Enum.GetValues<UserRole>())
                {
                    <MudSelectItem Value="@role">
                        @role.ToString()
                    </MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       OnClick="RegisterUser">
                Register
            </MudButton>

        </MudForm>

    </MudPaper>

</MudContainer>

@code {
    private MudForm? _form;
    private RegisterRequest _model = new();

    async Task RegisterUser()
    {
        await _form!.ValidateAsync();

        if (_form.IsValid)
        {
            var result = await UserService.Register(_model);

            if (result)
            {
                Snackbar.Add("User registered successfully", Severity.Success);
                Navigation.NavigateTo("/");
            }
        }
    }
}
